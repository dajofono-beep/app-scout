# Copiá este archivo como .env.local y completá los valores desde
# Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Secreta: solo se usa en el servidor (API routes), nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Para la sección Consultas (chat con IA). Se genera gratis, sin tarjeta,
# en https://aistudio.google.com/apikey — secreta, solo se usa en el servidor.
GEMINI_API_KEY=AIza...
